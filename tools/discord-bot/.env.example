# Discord bot token (Developer Portal -> Bot -> Reset Token)
DISCORD_TOKEN=your-bot-token

# Application ID (Developer Portal -> General Information)
# Optional at runtime; used to build the invite URL.
DISCORD_CLIENT_ID=your-application-id

# Optional: set this while developing so /bug registers instantly in one guild.
# Leave empty for global registration (can take up to an hour).
DISCORD_GUILD_ID=

# GitHub App created by tools/github-app/create_app.py
GITHUB_APP_ID=your-app-id
GITHUB_APP_PRIVATE_KEY_PATH=C:/path/to/github-app.pem
GITHUB_INSTALLATION_ID=your-installation-id
GITHUB_OWNER=Excurs1ons
GITHUB_REPO=PrismaRev
